{
  "name": "magrin-phishing-simulation",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de uma simulacao academica e controlada de phishing.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db": "npm run db:setup",
    "db:check": "npm run build --silent && node dist/scripts/check-db.js",
    "db:init": "npm run db:setup",
    "db:reset": "npm run build --silent && node dist/scripts/reset-db.js",
    "db:setup": "npm run build --silent && node dist/scripts/setup-db.js",
    "email:check": "npm run build --silent && node dist/scripts/check-email.js",
    "email:send": "npm run build --silent && node dist/scripts/send-email.js",
    "env:check": "npm run build --silent && node dist/scripts/check-env.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "mariadb": "^3.5.3",
    "nodemailer": "^9.0.6",
    "sequelize": "^6.37.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
