# -----------------------------------------------------------------------------
# Aplicacao local
# -----------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# URL inserida nos links do e-mail. Para outro aparelho autorizado na mesma
# rede, substitua localhost pelo IP local do notebook que executa o servidor.
SIMULATION_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# MariaDB
# Edite DB_PASSWORD antes de executar npm run db.
# -----------------------------------------------------------------------------
DB_DIALECT=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=phising
DB_USERNAME=root
DB_PASSWORD=change-me
DB_LOGGING=false
DB_SYNC=false

# -----------------------------------------------------------------------------
# E-mail
# Modos permitidos: disabled, mailpit ou smtp.
# O modelo compartilhado nunca habilita envio externo por padrao.
# -----------------------------------------------------------------------------
EMAIL_MODE=disabled
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=simulacao-academica@example.test

# Enderecos separados por virgula. Use somente participantes autorizados.
EMAIL_RECIPIENT_ALLOWLIST=participante@example.test

# -----------------------------------------------------------------------------
# Protecao administrativa
# Troque o token por um valor local com pelo menos 24 caracteres.
# -----------------------------------------------------------------------------
ADMIN_API_TOKEN=troque-este-token-administrativo-local

# Permite autorizar um voluntario pelo terminal por tempo limitado e uso unico.
# Mantenha false ate existir autorizacao para o teste externo.
ALLOW_RUNTIME_RECIPIENT_AUTHORIZATION=false
RUNTIME_RECIPIENT_AUTHORIZATION_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Identidades inteiramente ficticias da demonstracao
# Nunca adicione CPF real nesta lista.
# -----------------------------------------------------------------------------
ALLOWED_PARTICIPANT_CODES=P001,P002,P003
ALLOWED_TEST_CPFS=00000000000,11111111111,22222222222
